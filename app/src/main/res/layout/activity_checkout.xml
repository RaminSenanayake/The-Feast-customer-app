<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.CheckoutActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Checkout" />

    <RadioGroup
        android:id="@+id/order_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:checkedButton="@id/pickup"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Order option"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/pickup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:enabled="true"
            android:text="Pickup" />

        <RadioButton
            android:id="@+id/delivery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:checked="false"
            android:enabled="true"
            android:text="Delivery" />
    </RadioGroup>

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/adlam_display"
        android:text="Order Summary"
        android:textColor="@color/md_theme_primary"
        android:textSize="24sp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="10dp"
        android:columnCount="2"
        android:useDefaultMargins="true">

        <com.google.android.material.textview.MaterialTextView
            android:layout_columnSpan="1"
            android:fontFamily="@font/actor"
            android:text="Order Total"
            android:textSize="16sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/order_total"
            android:layout_columnSpan="1"
            android:layout_gravity="end"
            android:text="LKR 15890.98"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_columnSpan="1"
            android:fontFamily="@font/actor"
            android:text="Delivery Fee"
            android:textSize="16sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/delivery_fee"
            android:layout_columnSpan="1"
            android:layout_gravity="end"
            android:text="LKR 890.98"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/delivery_fee_text"
            android:layout_columnSpan="2"
            android:text="@string/short_distance_string"
            android:textSize="12sp"
            android:visibility="invisible" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_columnSpan="1"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/actor"
            android:text="Total"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/total_fee"
            android:layout_columnSpan="1"
            android:layout_gravity="end"
            android:layout_marginTop="20dp"
            android:text="LKR 17890.98"
            android:textSize="18sp"
            android:textStyle="bold" />
    </GridLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/pay_now_btn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="20dp"
        android:text="Pay Now"
        android:fontFamily="@font/adlam_display"
        android:textSize="18sp"/>
</LinearLayout>